{
  "worker": {
    "engine": "claude",
    "model": "claude-opus-5[1m]",
    "effort": "xhigh"
  },
  "review": {
    "engine": "claude",
    "model": "claude-opus-5[1m]",
    "effort": "xhigh"
  },
  "verify": {
    "enabled": true,
    "modes": ["IMPLEMENT", "REFACTOR", "TEST", "VERIFY"],
    "commands": [
      {
        "name": "install",
        "cmd": "yarn install --immutable",
        "on_failure": "block",
        "timeout_ms": 300000
      },
      {
        "name": "compile",
        "cmd": "yarn build",
        "on_failure": "block",
        "timeout_ms": 300000
      },
      {
        "name": "test",
        "cmd": "yarn test",
        "on_failure": "block",
        "timeout_ms": 600000
      }
    ]
  },
  "allowedTools": [
    "Read",
    "Edit",
    "Write",
    "Grep",
    "Glob",
    "WebSearch",
    "WebFetch",
    "Bash(git status *)",
    "Bash(git diff *)",
    "Bash(git log *)",
    "Bash(git add *)",
    "Bash(git commit *)",
    "Bash(git branch *)",
    "Bash(gh issue *)",
    "Bash(gh label *)",
    "Bash(yarn *)",
    "Bash(node *)"
  ]
}
